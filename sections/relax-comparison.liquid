{{ 'relax.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{%- capture cell_check -%}
  <span class="relax-compare__check">{% render 'relax-icon', icon: 'check' %}</span>
  <span class="visually-hidden">Oui</span>
{%- endcapture -%}
{%- capture cell_cross -%}
  <span class="relax-compare__cross">{% render 'relax-icon', icon: 'cross' %}</span>
  <span class="visually-hidden">Non</span>
{%- endcapture -%}

<div class="color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width section-{{ section.id }}-padding">
    <div class="relax-center">
      {%- if section.settings.eyebrow != blank -%}
        <span class="relax-eyebrow">{{ section.settings.eyebrow }}</span>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="relax-section-title {{ section.settings.heading_size }}">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.subheading != blank -%}
        <p class="relax-section-subtitle">{{ section.settings.subheading }}</p>
      {%- endif -%}
    </div>

    <div class="relax-compare">
      <table>
        <thead>
          <tr>
            <th scope="col"></th>
            <th scope="col" class="relax-compare__hero">{{ section.settings.col1_label }}</th>
            <th scope="col">{{ section.settings.col2_label }}</th>
            {%- if section.settings.col3_label != blank -%}
              <th scope="col">{{ section.settings.col3_label }}</th>
            {%- endif -%}
          </tr>
        </thead>
        <tbody>
          {%- for block in section.blocks -%}
            <tr {{ block.shopify_attributes }}>
              <th scope="row">{{ block.settings.label }}</th>
              <td class="relax-compare__hero">
                {%- case block.settings.col1_value -%}
                  {%- when 'oui' -%}{{ cell_check }}
                  {%- when 'non' -%}{{ cell_cross }}
                  {%- else -%}{{ block.settings.col1_text }}
                {%- endcase -%}
              </td>
              <td>
                {%- case block.settings.col2_value -%}
                  {%- when 'oui' -%}{{ cell_check }}
                  {%- when 'non' -%}{{ cell_cross }}
                  {%- else -%}{{ block.settings.col2_text }}
                {%- endcase -%}
              </td>
              {%- if section.settings.col3_label != blank -%}
                <td>
                  {%- case block.settings.col3_value -%}
                    {%- when 'oui' -%}{{ cell_check }}
                    {%- when 'non' -%}{{ cell_cross }}
                    {%- else -%}{{ block.settings.col3_text }}
                  {%- endcase -%}
                </td>
              {%- endif -%}
            </tr>
          {%- endfor -%}
        </tbody>
      </table>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Tableau comparatif",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Sur-titre",
      "default": "Faites le bon choix"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Titre",
      "default": "Relaxialis face aux alternatives"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Taille du titre",
      "options": [
        { "value": "h2", "label": "Moyen" },
        { "value": "h1", "label": "Grand" },
        { "value": "h0", "label": "Très grand" }
      ],
      "default": "h1"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Sous-titre"
    },
    {
      "type": "text",
      "id": "col1_label",
      "label": "Colonne 1 (votre produit)",
      "default": "Relaxialis"
    },
    {
      "type": "text",
      "id": "col2_label",
      "label": "Colonne 2",
      "default": "Coussin massant classique"
    },
    {
      "type": "text",
      "id": "col3_label",
      "label": "Colonne 3 (laisser vide pour masquer)",
      "default": "Massage en institut"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Palette de couleurs",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Marges internes"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Marge supérieure",
      "default": 52
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Marge inférieure",
      "default": 52
    }
  ],
  "blocks": [
    {
      "type": "row",
      "name": "Critère",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Critère",
          "default": "Critère de comparaison"
        },
        {
          "type": "select",
          "id": "col1_value",
          "label": "Colonne 1",
          "options": [
            { "value": "oui", "label": "✓ Oui" },
            { "value": "non", "label": "✗ Non" },
            { "value": "texte", "label": "Texte libre" }
          ],
          "default": "oui"
        },
        {
          "type": "text",
          "id": "col1_text",
          "label": "Colonne 1 — texte libre"
        },
        {
          "type": "select",
          "id": "col2_value",
          "label": "Colonne 2",
          "options": [
            { "value": "oui", "label": "✓ Oui" },
            { "value": "non", "label": "✗ Non" },
            { "value": "texte", "label": "Texte libre" }
          ],
          "default": "non"
        },
        {
          "type": "text",
          "id": "col2_text",
          "label": "Colonne 2 — texte libre"
        },
        {
          "type": "select",
          "id": "col3_value",
          "label": "Colonne 3",
          "options": [
            { "value": "oui", "label": "✓ Oui" },
            { "value": "non", "label": "✗ Non" },
            { "value": "texte", "label": "Texte libre" }
          ],
          "default": "non"
        },
        {
          "type": "text",
          "id": "col3_text",
          "label": "Colonne 3 — texte libre"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Tableau comparatif",
      "blocks": [
        { "type": "row", "settings": { "label": "Massage EMS + chaleur", "col1_value": "oui", "col2_value": "non", "col3_value": "non" } },
        { "type": "row", "settings": { "label": "Utilisable partout, sans fil", "col1_value": "oui", "col2_value": "non", "col3_value": "non" } },
        { "type": "row", "settings": { "label": "15 minutes suffisent", "col1_value": "oui", "col2_value": "non", "col3_value": "non" } },
        { "type": "row", "settings": { "label": "Coût", "col1_value": "texte", "col1_text": "Un seul achat", "col2_value": "texte", "col2_text": "Un seul achat", "col3_value": "texte", "col3_text": "50 € et plus par séance" } },
        { "type": "row", "settings": { "label": "Garantie satisfait ou remboursé", "col1_value": "oui", "col2_value": "non", "col3_value": "non" } }
      ]
    }
  ]
}
{% endschema %}
