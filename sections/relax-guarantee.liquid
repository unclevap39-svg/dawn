{{ 'relax.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width section-{{ section.id }}-padding">
    <div class="relax-guarantee">
      <span class="relax-icon">{% render 'relax-icon', icon: section.settings.icon %}</span>
      {%- if section.settings.heading != blank -%}
        <h2 class="{{ section.settings.heading_size }}">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.text != blank -%}
        <div class="relax-guarantee__text rte">{{ section.settings.text }}</div>
      {%- endif -%}
      {%- if section.settings.button_label != blank -%}
        <a href="{{ section.settings.button_link | default: '#' }}" class="button">{{ section.settings.button_label }}</a>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Bandeau garantie",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "select",
      "id": "icon",
      "label": "Icône",
      "options": [
        { "value": "shield", "label": "Bouclier" },
        { "value": "heart", "label": "Cœur" },
        { "value": "lotus", "label": "Lotus" },
        { "value": "return", "label": "Retours" },
        { "value": "lock", "label": "Cadenas" }
      ],
      "default": "shield"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Titre",
      "default": "30 jours pour l'essayer, zéro risque"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Taille du titre",
      "options": [
        { "value": "h2", "label": "Moyen" },
        { "value": "h1", "label": "Grand" },
        { "value": "h0", "label": "Très grand" }
      ],
      "default": "h1"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Texte",
      "default": "<p>Testez votre masseur Relaxialis tranquillement chez vous pendant 30 jours. S'il ne vous convient pas, renvoyez-le : nous vous remboursons intégralement, sans discuter.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Texte du bouton",
      "default": "J'essaie sans risque"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Lien du bouton"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Palette de couleurs",
      "default": "scheme-3"
    },
    {
      "type": "header",
      "content": "Marges internes"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Marge supérieure",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Marge inférieure",
      "default": 60
    }
  ],
  "presets": [
    {
      "name": "Bandeau garantie"
    }
  ]
}
{% endschema %}
