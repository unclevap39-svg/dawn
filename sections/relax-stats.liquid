{{ 'relax.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width section-{{ section.id }}-padding">
    {%- if section.settings.heading != blank -%}
      <div class="relax-center">
        <h2 class="relax-section-title {{ section.settings.heading_size }}">{{ section.settings.heading }}</h2>
      </div>
    {%- endif -%}

    <div class="relax-stats__grid" style="--relax-stats-count: {{ section.blocks.size | at_most: 4 }};">
      {%- for block in section.blocks -%}
        <div class="relax-stats__item" {{ block.shopify_attributes }}>
          <span class="relax-stats__value">{{ block.settings.value }}</span>
          <span class="relax-stats__label">{{ block.settings.label }}</span>
        </div>
      {%- endfor -%}
    </div>

    {%- if section.settings.footnote != blank -%}
      <p class="relax-stats__footnote">{{ section.settings.footnote }}</p>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Chiffres clés",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "paragraph",
      "content": "N'affichez que des chiffres réels et vérifiables (sondages clients, statistiques de vente…)."
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Titre",
      "default": ""
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Taille du titre",
      "options": [
        { "value": "h2", "label": "Moyen" },
        { "value": "h1", "label": "Grand" },
        { "value": "h0", "label": "Très grand" }
      ],
      "default": "h1"
    },
    {
      "type": "text",
      "id": "footnote",
      "label": "Note de bas de section (source des chiffres)",
      "default": ""
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Palette de couleurs",
      "default": "scheme-3"
    },
    {
      "type": "header",
      "content": "Marges internes"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Marge supérieure",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Marge inférieure",
      "default": 48
    }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "Chiffre",
      "settings": [
        {
          "type": "text",
          "id": "value",
          "label": "Valeur",
          "default": "15 min"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Description",
          "default": "par séance, c'est tout ce qu'il faut"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Chiffres clés",
      "blocks": [
        { "type": "stat", "settings": { "value": "15 min", "label": "par séance, c'est tout ce qu'il faut" } },
        { "type": "stat", "settings": { "value": "6 modes", "label": "de massage pour varier les plaisirs" } },
        { "type": "stat", "settings": { "value": "30 jours", "label": "pour l'essayer, satisfait ou remboursé" } }
      ]
    }
  ]
}
{% endschema %}
