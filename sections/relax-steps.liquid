{{ 'relax.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width section-{{ section.id }}-padding">
    <div class="relax-center">
      {%- if section.settings.eyebrow != blank -%}
        <span class="relax-eyebrow">{{ section.settings.eyebrow }}</span>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="relax-section-title {{ section.settings.heading_size }}">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.subheading != blank -%}
        <p class="relax-section-subtitle">{{ section.settings.subheading }}</p>
      {%- endif -%}
    </div>

    <div class="relax-steps__grid" style="--relax-steps-count: {{ section.blocks.size | at_most: 4 }};">
      {%- for block in section.blocks -%}
        <div class="relax-steps__item" {{ block.shopify_attributes }}>
          {%- if block.settings.image != blank -%}
            <div class="relax-steps__image">
              {{ block.settings.image | image_url: width: 800 | image_tag: loading: 'lazy', widths: '400, 600, 800' }}
            </div>
          {%- endif -%}
          <span class="relax-steps__number" aria-hidden="true"></span>
          {%- if block.settings.heading != blank -%}
            <h3>{{ block.settings.heading }}</h3>
          {%- endif -%}
          {%- if block.settings.text != blank -%}
            <p>{{ block.settings.text }}</p>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Étapes numérotées",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Sur-titre",
      "default": "Simple comme bonjour"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Titre",
      "default": "Comment ça marche ?"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Taille du titre",
      "options": [
        { "value": "h2", "label": "Moyen" },
        { "value": "h1", "label": "Grand" },
        { "value": "h0", "label": "Très grand" }
      ],
      "default": "h1"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Sous-titre",
      "default": ""
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Palette de couleurs",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Marges internes"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Marge supérieure",
      "default": 52
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Marge inférieure",
      "default": 52
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Étape",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image (optionnelle)"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Titre",
          "default": "Titre de l'étape"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Texte",
          "default": "Décrivez cette étape en une phrase."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Étapes numérotées",
      "blocks": [
        { "type": "step", "settings": { "heading": "Placez-le autour du cou", "text": "Ajustez le masseur autour de votre nuque : il épouse la forme de vos cervicales." } },
        { "type": "step", "settings": { "heading": "Choisissez votre programme", "text": "Sélectionnez le mode et l'intensité qui vous conviennent, avec ou sans chaleur." } },
        { "type": "step", "settings": { "heading": "Profitez de 15 minutes de détente", "text": "Laissez les impulsions et la chaleur relâcher les tensions accumulées dans la journée." } }
      ]
    }
  ]
}
{% endschema %}
