{{ 'relax.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width section-{{ section.id }}-padding">
    <div class="relax-center">
      {%- if section.settings.eyebrow != blank -%}
        <span class="relax-eyebrow">{{ section.settings.eyebrow }}</span>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="relax-section-title {{ section.settings.heading_size }}">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.subheading != blank -%}
        <p class="relax-section-subtitle">{{ section.settings.subheading }}</p>
      {%- endif -%}
    </div>

    {%- if section.settings.show_summary -%}
      <div class="relax-reviews-summary">
        <div class="relax-reviews-summary__score">
          <span class="relax-reviews-summary__average">{{ section.settings.summary_average }}<span class="relax-reviews-summary__outof">/5</span></span>
          <div class="relax-testimonial__stars" role="img" aria-label="Note moyenne {{ section.settings.summary_average }} sur 5">
            {% render 'relax-stars', rating: 5 %}
          </div>
          {%- if section.settings.summary_count != blank -%}
            <span class="relax-reviews-summary__count">{{ section.settings.summary_count }}</span>
          {%- endif -%}
        </div>
        <div class="relax-reviews-summary__bars">
          {%- assign bar_values = section.settings.bar_5 | append: ',' | append: section.settings.bar_4 | append: ',' | append: section.settings.bar_3 | append: ',' | append: section.settings.bar_2 | append: ',' | append: section.settings.bar_1 | split: ',' -%}
          {%- for value in bar_values -%}
            {%- assign star_label = 5 | minus: forloop.index0 -%}
            <div class="relax-reviews-summary__bar-row">
              <span class="relax-reviews-summary__bar-label">{{ star_label }} ★</span>
              <div class="relax-reviews-summary__bar-track">
                <div class="relax-reviews-summary__bar-fill" style="width: {{ value }}%;"></div>
              </div>
              <span class="relax-reviews-summary__bar-value">{{ value }} %</span>
            </div>
          {%- endfor -%}
        </div>
      </div>
    {%- endif -%}

    <div class="relax-testimonials__grid">
      {%- for block in section.blocks -%}
        <div class="relax-testimonial" {{ block.shopify_attributes }}>
          {%- if block.settings.photo != blank -%}
            <div class="relax-testimonial__photo">
              {{ block.settings.photo | image_url: width: 720 | image_tag: loading: 'lazy', widths: '360, 540, 720' }}
            </div>
          {%- endif -%}
          <div class="relax-testimonial__stars" role="img" aria-label="{{ block.settings.rating }} étoiles sur 5">
            {% render 'relax-stars', rating: block.settings.rating %}
          </div>
          {%- if block.settings.title != blank -%}
            <h3 class="relax-testimonial__title">{{ block.settings.title }}</h3>
          {%- endif -%}
          {%- if block.settings.quote != blank -%}
            <blockquote class="relax-testimonial__quote">{{ block.settings.quote }}</blockquote>
          {%- endif -%}
          <div class="relax-testimonial__footer">
            {%- if block.settings.avatar != blank -%}
              <div class="relax-testimonial__avatar">
                {{ block.settings.avatar | image_url: width: 120 | image_tag: loading: 'lazy' }}
              </div>
            {%- endif -%}
            <div>
              {%- if block.settings.author != blank -%}
                <div class="relax-testimonial__author">{{ block.settings.author }}</div>
              {%- endif -%}
              {%- if block.settings.meta != blank -%}
                <div class="relax-testimonial__meta">{{ block.settings.meta }}</div>
              {%- endif -%}
              {%- if block.settings.verified -%}
                <span class="relax-testimonial__verified">
                  {% render 'relax-icon', icon: 'check' %}
                  Achat vérifié
                </span>
              {%- endif -%}
            </div>
            {%- if block.settings.date != blank -%}
              <span class="relax-testimonial__date">{{ block.settings.date }}</span>
            {%- endif -%}
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Témoignages clients",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "paragraph",
      "content": "⚠️ N'affichez que de vrais avis clients et des chiffres exacts : les avis fictifs sont interdits par la loi et par Meta."
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Sur-titre",
      "default": "Ils l'ont adopté"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Titre",
      "default": "Ce que disent nos clients"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Taille du titre",
      "options": [
        { "value": "h2", "label": "Moyen" },
        { "value": "h1", "label": "Grand" },
        { "value": "h0", "label": "Très grand" }
      ],
      "default": "h1"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Sous-titre"
    },
    {
      "type": "header",
      "content": "Synthèse des avis"
    },
    {
      "type": "checkbox",
      "id": "show_summary",
      "label": "Afficher la synthèse (note moyenne + répartition)",
      "default": false
    },
    {
      "type": "text",
      "id": "summary_average",
      "label": "Note moyenne",
      "default": "4,8"
    },
    {
      "type": "text",
      "id": "summary_count",
      "label": "Nombre d'avis (ex. « Basé sur 11 avis »)",
      "default": "Basé sur nos premiers avis clients"
    },
    {
      "type": "range",
      "id": "bar_5",
      "label": "% d'avis 5 étoiles",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 80
    },
    {
      "type": "range",
      "id": "bar_4",
      "label": "% d'avis 4 étoiles",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 15
    },
    {
      "type": "range",
      "id": "bar_3",
      "label": "% d'avis 3 étoiles",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 4
    },
    {
      "type": "range",
      "id": "bar_2",
      "label": "% d'avis 2 étoiles",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 1
    },
    {
      "type": "range",
      "id": "bar_1",
      "label": "% d'avis 1 étoile",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 0
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Palette de couleurs",
      "default": "scheme-2"
    },
    {
      "type": "header",
      "content": "Marges internes"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Marge supérieure",
      "default": 52
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Marge inférieure",
      "default": 52
    }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Témoignage",
      "settings": [
        {
          "type": "range",
          "id": "rating",
          "label": "Note (étoiles)",
          "min": 1,
          "max": 5,
          "step": 1,
          "default": 5
        },
        {
          "type": "text",
          "id": "title",
          "label": "Titre de l'avis"
        },
        {
          "type": "textarea",
          "id": "quote",
          "label": "Avis",
          "default": "Ajoutez ici un avis client authentique."
        },
        {
          "type": "image_picker",
          "id": "photo",
          "label": "Photo jointe à l'avis (optionnelle)"
        },
        {
          "type": "text",
          "id": "author",
          "label": "Prénom",
          "default": "Prénom N."
        },
        {
          "type": "text",
          "id": "meta",
          "label": "Précision (ville, âge…)"
        },
        {
          "type": "text",
          "id": "date",
          "label": "Date de l'avis"
        },
        {
          "type": "checkbox",
          "id": "verified",
          "label": "Afficher le badge « Achat vérifié »",
          "default": true
        },
        {
          "type": "image_picker",
          "id": "avatar",
          "label": "Photo de profil (optionnelle)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Témoignages clients",
      "blocks": [
        { "type": "testimonial" },
        { "type": "testimonial" },
        { "type": "testimonial" }
      ]
    }
  ]
}
{% endschema %}
